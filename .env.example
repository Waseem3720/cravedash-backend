# PostgreSQL
DATABASE_URL=postgres://cravedash:cravedash@localhost:5432/cravedash
PGHOST=localhost
PGPORT=5432
PGUSER=cravedash
PGPASSWORD=cravedash
PGDATABASE=cravedash

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES=7d
GATEWAY_JWT_VERIFY=optional

# Rate limits (optional). When set, login/PIN/MFA limiters use Redis; otherwise in-memory.
# REDIS_URL=redis://127.0.0.1:6379

# CORS (comma-separated origins or * )
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173

# Service ports (local dev)
PORT=4000
GATEWAY_PORT=4000
AUTH_SERVICE_URL=http://127.0.0.1:4001
CATALOG_SERVICE_URL=http://127.0.0.1:4002
ORDER_SERVICE_URL=http://127.0.0.1:4003
RESTAURANT_SERVICE_URL=http://127.0.0.1:4004
PLATFORM_SERVICE_URL=http://127.0.0.1:4005
EPOS_SERVICE_URL=http://127.0.0.1:4006
REPORTING_SERVICE_URL=http://127.0.0.1:4007

# Encrypt integration secrets at rest (defaults to JWT_SECRET if unset)
# INTEGRATIONS_SECRET_KEY=long-random-string

# Public URL (Stripe redirects, webhook hints)
# PUBLIC_APP_URL=https://crave.softwarehouseinlahore.com
# FRONTEND_URL=https://crave.softwarehouseinlahore.com

# Platform Stripe (or configure via Super Admin → Stripe)
# STRIPE_SECRET_KEY=sk_live_…
# STRIPE_WEBHOOK_SECRET=whsec_…

# Optional: server-side print agent URL (usually run on till PC instead)
# PRINT_AGENT_URL=http://host.docker.internal:9108
# PRINT_AGENT_KEY=

# Optional platform-wide SMS/SMTP fallbacks (restaurant integrations blob preferred)
# SMS_ACCOUNT_SID=
# SMS_AUTH_TOKEN=
# SMS_FROM=
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_SECRET=
# MAIL_FROM_ADDRESS=
