# ==============================================================================
# CraveDash Environment Configuration (.env.example)
# Copy to .env and customize for your environment: cp .env.example .env
#
# Production Security Note:
#   Generate cryptographically secure random secrets on your terminal using:
#     openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# PRECEDENCE ORDER:
# 1. Discrete parameters (PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE):
#    Takes HIGHEST precedence whenever PGHOST is set. This is the recommended mode
#    because discrete parameters pass credentials directly to the PostgreSQL driver
#    without URL parsing, making passwords with URL-special characters (e.g. '@', '#', '%', ':')
#    100% safe without requiring URL percent-encoding.
# 2. DATABASE_URL:
#    Used as fallback when PGHOST is unset or omitted (e.g. for external cloud databases).
#    If using DATABASE_URL with special characters in user/password, they MUST be percent-encoded.
#
# Local development default points to localhost:5432.
# When running under Docker Compose (docker-compose.prod.yml), internal services
# automatically connect to container host 'postgres:5432'.
PGHOST=localhost
PGPORT=5432
PGUSER=cravedash
PGPASSWORD=cravedash
PGDATABASE=cravedash
PGPOOL_MAX=10

# Optional single connection string URL (used ONLY when PGHOST is omitted):
# DATABASE_URL=postgres://cravedash:cravedash@localhost:5432/cravedash

# Optional migration lock & statement timeouts in milliseconds (shared/scripts/migrate.js)
# PG_LOCK_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 2. Core Security & Authentication (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), JWT_SECRET is strictly validated on startup:
#   - Must be >= 32 characters in length
#   - Cannot be a known placeholder (e.g. 'dev-change-me', 'cravedash', etc.)
#   - Generates fatal error if invalid or missing
# Generate via: openssl rand -hex 32
JWT_SECRET=change-me-to-a-secure-random-secret-at-least-32-chars-long

# JWT token expiration durations
JWT_EXPIRES=7d
# JWT_IMPERSONATE_EXPIRES=15m
# JWT_EPOS_STAFF_EXPIRES=12h
# JWT_EMAIL_VERIFY_EXPIRES=15m

# Gateway edge JWT verification mode: 'optional' (default), 'strict', or 'off'
# NOTE: Setting 'off' is strictly forbidden in production.
GATEWAY_JWT_VERIFY=optional

# Required in production. Used for AES-256-GCM encryption of third-party
# integration credentials at rest (secretsCrypto.js).
#   - Must be explicitly set and not a placeholder in production
#   - Generates fatal error if invalid or missing in production
# Generate via: openssl rand -hex 32
INTEGRATIONS_SECRET_KEY=change-me-to-at-least-16-characters-in-production

# ------------------------------------------------------------------------------
# 3. CORS & Networking (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), CORS_ORIGIN is strictly validated on startup
# by Gateway and all services. Setting '*' or leaving empty causes a fatal process exit.
# Must be an explicit, comma-separated list of allowed web origins.
#
# Local development example:
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGIN=https://crave.yourdomain.com,https://admin.yourdomain.com

# HTTP log format: 'dev' (default) or 'combined' (production recommended)
# LOG_FORMAT=dev

# ------------------------------------------------------------------------------
# 4. Service Ports & Gateway Proxy Targets (Local Dev Defaults)
# ------------------------------------------------------------------------------
# Docker Compose automatically overrides downstream URLs to container hostnames.
PORT=4000
GATEWAY_PORT=4000
AUTH_SERVICE_URL=http://127.0.0.1:4001
CATALOG_SERVICE_URL=http://127.0.0.1:4002
ORDER_SERVICE_URL=http://127.0.0.1:4003
RESTAURANT_SERVICE_URL=http://127.0.0.1:4004
PLATFORM_SERVICE_URL=http://127.0.0.1:4005
EPOS_SERVICE_URL=http://127.0.0.1:4006
REPORTING_SERVICE_URL=http://127.0.0.1:4007

# ------------------------------------------------------------------------------
# 5. Public Application & Domain URLs
# ------------------------------------------------------------------------------
# BASE_URL: Used by restaurant-service to construct table QR code URLs
# BASE_URL=https://crave.yourdomain.com

# Public URLs for frontend portals, email verification confirmation links, etc.
# PUBLIC_APP_URL=https://crave.yourdomain.com
# FRONTEND_URL=https://crave.yourdomain.com
# APP_URL=https://crave.yourdomain.com

# PUBLIC_API_URL: Public URL of the API Gateway, used for OAuth redirect callbacks (Stripe Connect)
# PUBLIC_API_URL=https://api.yourdomain.com

# ------------------------------------------------------------------------------
# 6. Optional External Integrations (Backend starts cleanly without these)
# ------------------------------------------------------------------------------
# Redis for distributed rate-limiting & OTP store (falls back to in-memory if unset)
# REDIS_URL=redis://127.0.0.1:6379

# Platform-wide Stripe billing & Connect accounts (can also configure via UI)
# STRIPE_SECRET_KEY=sk_live_your_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# STRIPE_HELD_PAYOUT_CRON=1

# Local or remote print-agent bridge for receipt & kitchen thermal printers
# PRINT_AGENT_URL=http://127.0.0.1:9108
# PRINT_AGENT_KEY=

# Optional platform fallback for SMS (Twilio)
# SMS_ACCOUNT_SID=
# SMS_AUTH_TOKEN=
# SMS_FROM=

# Optional platform fallback for SMTP Email (Nodemailer)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@cravedash.internal

# Optional reCAPTCHA secret key
# RECAPTCHA_SECRET_KEY=
